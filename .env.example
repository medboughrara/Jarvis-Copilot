# ==============================================================================
# JARVIS AI / JARVIS-COPILOT — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your API credentials.
# ==============================================================================

# --- Core LLM Pool: Google Gemini (Tier 1) ---
# Multi-key pool: comma-separated list of Gemini API keys for automatic round-robin & 429 cooling
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
# Or single key fallback
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USE_GEMINI=true

# --- Cloud Reasoning Pool: NVIDIA NIM Cloud (Tier 2) ---
NVIDIA_API_KEY=
NVIDIA_KIMI_KEY=
NVIDIA_NEMOTRON_KEY=
NVIDIA_NEMOTRON_OCR_KEY=
NVIDIA_NEMOTRON_EMBED_KEY=

# --- Cloud Fallback: Ollama Cloud (Tier 3) ---
OLLAMA_CLOUD_MODELS=glm-5.2:cloud,kimi-k3:cloud

# --- Local Offline Engine: Ollama Local (Tier 4) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# --- Workspace & Multi-App Cloud Integration (Composio MCP) ---
# Provides access to Gmail, Google Calendar, Notion, Google Sheets, Google Docs, Discord, Slack
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# --- Voice & Speech Configuration ---
WAKEWORD_MODEL_NAME=jarvis
WAKEWORD_THRESHOLD=0.5
STT_MODEL_SIZE=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_VOICE=en-US-ChristopherNeural

# --- Server & HUD ---
PORT=8000
HOST=localhost
